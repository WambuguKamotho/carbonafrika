# Database (Railway PostgreSQL plugin)
DATABASE_URL=postgresql://user:password@host:5432/carbonafrika

# Redis (Railway Redis plugin)
REDIS_URL=redis://host:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Blockchain (Polygon Mumbai Testnet)
POLYGON_RPC_URL=https://rpc-mumbai.maticvigil.com
DEPLOYER_PRIVATE_KEY=your-wallet-private-key
CARBON_TOKEN_ADDRESS=0x...
PROJECT_REGISTRY_ADDRESS=0x...
MARKETPLACE_ADDRESS=0x...
RETIREMENT_CERT_ADDRESS=0x...

# IPFS via Pinata
PINATA_API_KEY=your-pinata-api-key
PINATA_SECRET_KEY=your-pinata-secret

# Email via Resend
RESEND_API_KEY=re_your-resend-api-key
FROM_EMAIL=noreply@carbonafrika.com

# Service URLs (internal Railway networking)
AUTH_SERVICE_URL=http://auth-service:3001
PROJECT_SERVICE_URL=http://project-service:3002
MARKETPLACE_SERVICE_URL=http://marketplace-service:3003
VERIFICATION_SERVICE_URL=http://verification-service:3004
NOTIFICATION_SERVICE_URL=http://notification-service:3005

# Ports
AUTH_PORT=3001
PROJECT_PORT=3002
MARKETPLACE_PORT=3003
VERIFICATION_PORT=3004
NOTIFICATION_PORT=3005
WORKER_PORT=3006

# Emissions.dev — country-specific CO₂ factors for IoT readings + corporate calculator
# Get your key at https://emissions.dev
EMISSIONS_DEV_API_KEY=your-emissions-dev-api-key

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_POLYGON_CHAIN_ID=80001
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id
