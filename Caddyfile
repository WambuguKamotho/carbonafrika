# Caddy automatically obtains + renews Let's Encrypt TLS for these hostnames.
# Change the email to a real inbox for cert-expiry notices.
{
	email tembomediaagency@gmail.com
}

# Redirect www → apex
www.kabon.africa {
	redir https://kabon.africa{uri} permanent
}

# The website. API calls (relative /api/* from the browser) are routed to the
# gateway so they're same-origin (no CORS); everything else hits the Next.js app.
kabon.africa {
	encode gzip
	handle /api/* {
		reverse_proxy gateway:8080
	}
	handle {
		reverse_proxy web:3000
	}
}

# Public API — fans out to the microservices via the Express gateway.
api.kabon.africa {
	encode gzip
	reverse_proxy gateway:8080
}

# AI Quant Bot — signal dashboard & API (FastAPI on :8081). Password-protected.
# Set QUANT_USERNAME and QUANT_PASSWORD_HASH in the server .env file.
# Generate the hash on the server: docker run --rm caddy:2-alpine caddy hash-password --plaintext "yourpassword"
quant.kabon.africa {
	encode gzip
	basicauth {
		{env.QUANT_USERNAME} {env.QUANT_PASSWORD_HASH}
	}
	reverse_proxy quant-bot:8081
}

# WordPress blog
blog.kabon.africa {
	encode gzip
	reverse_proxy blog-nginx:80
}
