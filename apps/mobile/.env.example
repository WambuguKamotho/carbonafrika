# Base URL the app calls. In dev this points at your Next.js web server, which
# already proxies /api/* to all the microservices. Use your machine's LAN IP
# (NOT localhost — the phone/emulator can't reach your machine via localhost).
#
# Find it: Windows `ipconfig` → IPv4 Address. Then:
#   EXPO_PUBLIC_API_URL=http://192.168.1.23:3000
#
# In production this becomes your public API gateway URL.
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000
