# Copy this file to .env and fill in your keys.
# Required
ANTHROPIC_API_KEY=sk-ant-...
FRED_API_KEY=your_fred_key_here

# LLM provider — groq (default/free), anthropic, gemini, ollama
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_key_here

# Optional (free registration)
EIA_API_KEY=             # https://www.eia.gov/opendata/register.php
NEWSAPI_KEY=             # https://newsapi.org/
FIRMS_API_KEY=           # https://firms.modaps.eosdis.nasa.gov/api/

# Telegram bot (required for alerts and commands)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Claude model (only if LLM_PROVIDER=anthropic)
CLAUDE_MODEL=claude-sonnet-4-6

# Logging
LOG_LEVEL=INFO
